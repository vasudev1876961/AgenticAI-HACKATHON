# Model Provider API Keys (Optional - the system includes deterministic offline reasoning mode for reliable demos)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Framework & Execution Settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini
EXECUTION_MODE=hybrid  # options: llm, deterministic, hybrid
LOG_LEVEL=INFO
VERIFICATION_STRICT_MODE=true
MAX_CORRECTION_RETRIES=2
